<!-- Same stationary recovery policy as NavigateToPose. No hidden motion or
     costmap clearing. Incoming poses must fit the rolling planning window. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="BoundedNavigationThroughPoses">
      <PipelineSequence name="PlanAndFollow">
        <RateController hz="1.0">
          <ReactiveSequence>
            <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"/>
            <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
          </ReactiveSequence>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
      </PipelineSequence>
      <ReactiveFallback>
        <GoalUpdated/>
        <Wait wait_duration="3.0"/>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
