<?xml version="1.0"?>
<robot name="rover">
  <link name="base_link"/>
  <joint name="base_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <inertial>
      <origin
        xyz="-0.0584197742528739 -1.87173429318394E-05 0.100048316721529"
        rpy="0 0 0" />
      <mass value="22.9702313159612" />
      <inertia
        ixx="0.141165258251768"
        ixy="1.40109430878558E-06"
        ixz="-0.00149697070123729"
        iyy="0.198690083301802"
        iyz="-3.79691320033631E-07"
        izz="0.291025448460444" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/chassis.STL" />
      </geometry>
      <material name="">
        <color rgba="0.650980392156863 0.619607843137255 0.588235294117647 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.058 0 0.10" rpy="0 0 0" />
      <geometry>
        <box size="0.75 0.45 0.28" />
      </geometry>
    </collision>
  </link>

  <link name="left_hub_link">
    <inertial>
      <origin xyz="0.0043509 0.011495 -0.086762" rpy="0 0 0" />
      <mass value="0.43743" />
      <inertia
        ixx="0.00032323" ixy="2.3773E-07" ixz="1.7929E-05"
        iyy="0.00098519" iyz="-4.7612E-06" izz="0.00077528" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/left_hub_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.005 -0.06" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.06 0.18" />
      </geometry>
    </collision>
  </link>
  <joint name="left_hub_joint" type="revolute">
    <origin xyz="0.24617 0.25899 -0.02379" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="left_hub_link" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14" upper="3.14" effort="1" velocity="50" />
  </joint>

  <link name="left_front_wheel">
    <inertial>
      <origin xyz="-1.6989E-06 -0.031111 9.8985E-08" rpy="0 0 0" />
      <mass value="1.1548" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/left_front_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0.66667 0.69804 0.76863 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.02 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0975" length="0.06" />
      </geometry>
    </collision>
  </link>
  <joint name="left_front_joint" type="continuous">
    <origin xyz="0.217263894918702 0.109798 -0.111676144229464" rpy="0 0 0" />
    <parent link="left_hub_link" />
    <child link="left_front_wheel" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0" effort="22" velocity="57" />
  </joint>

  <link name="left_mid_wheel">
    <inertial>
      <origin xyz="9.3367E-07 -0.031111 1.4224E-06" rpy="0 0 0" />
      <mass value="1.1548" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/left_mid_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0.66667 0.69804 0.76863 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.02 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0975" length="0.06" />
      </geometry>
    </collision>
  </link>
  <joint name="left_mid_joint" type="continuous">
    <origin xyz="-0.205346325358771 0.109798 -0.13231798021001" rpy="0 0 0" />
    <parent link="left_hub_link" />
    <child link="left_mid_wheel" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0" effort="22" velocity="57" />
  </joint>

  <link name="right_hub_link">
    <inertial>
      <origin
        xyz="0.0174630738404854 -0.00831974620024573 -0.0850476178756101"
        rpy="0 0 0" />
      <mass value="0.437428680791758" />
      <inertia
        ixx="0.00032823008462876" ixy="-9.45568218961581E-07" ixz="-5.05577889254412E-05"
        iyy="0.000985186594170562" iyz="4.67237730248651E-06" izz="0.000770278551890062" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/right_hub_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.666666666666667 0.698039215686274 0.768627450980392 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.01 -0.01 -0.06" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.06 0.18" />
      </geometry>
    </collision>
  </link>
  <joint name="right_hub_joint" type="revolute">
    <origin xyz="0.24617 -0.25899 -0.02379" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="right_hub_link" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14" upper="3.14" effort="1" velocity="50" />
  </joint>

  <link name="right_front_wheel">
    <inertial>
      <origin xyz="-1.2563E-06 0.031111 1.1477E-06" rpy="0 0 0" />
      <mass value="1.1548" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/right_front_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0.66667 0.69804 0.76863 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.02 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0975" length="0.06" />
      </geometry>
    </collision>
  </link>
  <joint name="right_front_joint" type="continuous">
    <origin xyz="0.23167 -0.10662 -0.077493" rpy="0 0 0" />
    <parent link="right_hub_link" />
    <child link="right_front_wheel" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0" effort="22" velocity="57" />
  </joint>

  <link name="right_mid_wheel">
    <inertial>
      <origin xyz="1.6223E-06 0.031111 5.1534E-07" rpy="0 0 0" />
      <mass value="1.1548" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/right_mid_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0.66667 0.69804 0.76863 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.02 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0975" length="0.06" />
      </geometry>
    </collision>
  </link>
  <joint name="right_mid_joint" type="continuous">
    <origin xyz="-0.18294 -0.10662 -0.16188" rpy="0 0 0" />
    <parent link="right_hub_link" />
    <child link="right_mid_wheel" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0" effort="22" velocity="57" />
  </joint>

  <link name="left_back_wheel">
    <inertial>
      <origin xyz="1.002E-06 -0.031111 1.3752E-06" rpy="0 0 0" />
      <mass value="1.1548" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/left_back_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.02 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0975" length="0.06" />
      </geometry>
    </collision>
  </link>
  <joint name="left_back_joint" type="continuous">
    <origin xyz="-0.3984 0.36878 -0.14593" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="left_back_wheel" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0" effort="22" velocity="57" />
  </joint>

  <link name="right_back_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.1548" />
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://rover_description/meshes/right_back_wheel.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.02 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0975" length="0.06" />
      </geometry>
    </collision>
  </link>
  <joint name="right_back_joint" type="continuous">
    <origin xyz="-0.398397807372039 -0.368783 -0.145930651885583" rpy="0 0 0" />
    <parent link="chassis" />
    <child link="right_back_wheel" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0" effort="22" velocity="57" />
  </joint>

  <link name="gps_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.065 0.0305 0.010"/>
      </geometry>
      <material name="gps_green">
        <color rgba="0.1 0.4 0.1 1"/>
      </material>
    </visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="chassis"/>
    <child link="gps_link"/>
    <origin xyz="-0.1524 0.025 0.1238" rpy="0 0 0"/>
  </joint>
  <gazebo reference="gps_link">
    <sensor name="navsat" type="gps">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <gps>
      <position_sensing>
        <horizontal>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.5</stddev>
          </noise>
        </horizontal>
        <vertical>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.0</stddev>
          </noise>
        </vertical>
      </position_sensing>
      </gps>
      <plugin name="gps_controller" filename="libgazebo_ros_gps_sensor.so">
        <ros>
          <namespace>/rover</namespace>
          <remapping>~/out:=/gps/fix</remapping>
        </ros>
        <frame_name>gps_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.0254 0.0254 0.005"/>
      </geometry>
      <material name="imu_red">
        <color rgba="0.7 0.05 0.05 1"/>
      </material>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="-0.1524 -0.025 0.1238" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_controller" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/rover</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <link name="zed_camera_link">
    <visual>
      <geometry>
        <mesh filename="package://rover_description/meshes/zed2i.stl"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
  </link>

  <joint name="zed_camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="zed_camera_link"/>
    <origin xyz="0.2921 0 0.20" rpy="0 0 0"/>
  </joint>

  <gazebo reference="zed_camera_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <link name="zed_camera_optical_frame"/>

  <joint name="zed_camera_optical_joint" type="fixed">
    <parent link="zed_camera_link"/>
    <child link="zed_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="zed_imu_link"/>

  <gazebo reference="zed_camera_link">
    <sensor name="zed_depth_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.92</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.2</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="zed_depth_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/zed</namespace>
          <remapping>image_raw:=/rgb/image_raw</remapping>
          <remapping>depth/image_raw:=/depth/image_raw</remapping>
          <remapping>camera_info:=/rgb/camera_info</remapping>
          <remapping>depth/camera_info:=/depth/camera_info</remapping>
          <remapping>points:=/depth/points</remapping>
        </ros>
        <camera_name>zed_depth_camera</camera_name>
        <frame_name>zed_camera_optical_frame</frame_name>
        <min_depth>0.2</min_depth>
        <max_depth>20.0</max_depth>
      </plugin>
    </sensor>
    <sensor name="zed_imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <plugin name="zed_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/zed</namespace>
          <remapping>~/out:=/zed/zed_node/imu/data</remapping>
        </ros>
        <frame_name>zed_imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <joint name="zed_imu_joint" type="fixed">
    <parent link="zed_camera_link"/>
    <child link="zed_imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>



  <ros2_control name="Rover" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="left_front_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_mid_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_back_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_front_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_mid_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_back_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>@ROVER_CONTROLLER_CONFIG@</parameters>
    </plugin>
  </gazebo>

</robot>
