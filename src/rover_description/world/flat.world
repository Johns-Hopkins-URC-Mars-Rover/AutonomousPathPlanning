<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>39.323178</latitude_deg><longitude_deg>-76.627894</longitude_deg>
      <elevation>54.1</elevation><heading_deg>0</heading_deg>
    </spherical_coordinates>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver>
          <iters>20</iters>
        </solver>
      </ode>
    </physics>
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
  </world>
</sdf>