#include <memory>
#include "rclcpp/rclcpp.hpp"
#include "sensor_msgs/msg/nav_sat_fix.hpp"
#include "gps_interface/mock_driver.hpp"

using namespace std::chrono_literals

class GpsNode: public rclcpp::Node
{
public:
  GpsNode(): Node("gps_node") {
    publisher_ = create_publisher<sensor_msgs::msg::NavSatFix>("gps/fix", 10);
    driver_ = std::make_unique<gps_interface::MockGpsDriver>();
    driver_->connect();
    timer_ = create_wall_timer(200ms, std::bind(&GpsNode::publishFix, this));
  }

private:
  void publishFix() {
    auto data = driver_->readPosition();
    auto msg = sensor_msgs::msg::NavSatFix();
    msg.latitude = data.latitude;
    msg.longitude = data.longitude;
    msg.altitude = data.altitude;
    msg.status.status = data.fix_quality;
    publisher_->publish(msg);
  }

  rclcpp::Publisher<sensor_msgs::msg::NavSatFix>::SharedPtr publisher_;
  rclcpp::TimerBase::SharedPtr timer_;
  std::unique_ptr<gps_interface::GpsDriverBase> driver_;
};


int main(int argc, char** argv) {
  rclcpp::init(argc, argv);
  rclcpp::spin(std::make_shared<GpsNode>());
  rclcpp::shutdown();
  return 0;
}
